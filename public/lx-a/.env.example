# Lexus Concierge — optional Gemini brain (via a same-origin proxy).
#
# Copy this file to `.env.local`, set the two values below, restart `npm run dev`.
# Leave VITE_GEMINI_ENABLED unset and the concierge uses the built-in
# deterministic planner — the app works fully offline with no key.

# ── Server-side (proxy only — NEVER shipped to the browser) ──────────────────
# The dev/preview proxy (vite.config.ts) and the Cloudflare Worker read these.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Authoritative shared free-tier caps (proxy falls back / 429s past these):
# GEMINI_MAX_RPM=10
# GEMINI_MAX_RPD=200

# ── Client-side (safe to ship — no secret here) ──────────────────────────────
# Turn the Gemini brain on. The key stays server-side; this only flips the
# feature and routes requests through the proxy.
VITE_GEMINI_ENABLED=false
# Proxy endpoint. Default is the same-origin /api/gemini (works in dev/preview).
# In production, point this at your deployed Worker URL.
# VITE_GEMINI_PROXY_URL=/api/gemini
# Cheap client-side pre-check caps (the server proxy is the real guarantee):
# VITE_GEMINI_MAX_RPM=10
# VITE_GEMINI_MAX_RPD=200
